{
  "name": "hege",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "mobile:e2e:ios": "bash apps/mobile/scripts/maestro-ios.sh core",
    "mobile:e2e:ios:core": "bash apps/mobile/scripts/maestro-ios.sh core",
    "mobile:e2e:ios:queue": "bash apps/mobile/scripts/maestro-ios.sh queue",
    "mobile:e2e:ios:reviereinrichtungen": "bash apps/mobile/scripts/maestro-ios.sh reviereinrichtungen",
    "mobile:e2e:ios:reviereinrichtungen:queue": "bash apps/mobile/scripts/maestro-ios.sh reviereinrichtungen-queue",
    "mobile:e2e:ios:roles": "bash apps/mobile/scripts/maestro-ios.sh roles",
    "mobile:smoke:ios:session": "bash apps/mobile/scripts/ios-device-session-smoke.sh",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:web": "pnpm --filter @hege/web build && pnpm --filter @hege/web start:e2e",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "packageExtensions": {
      "@expo/vector-icons@14.1.0": {
        "peerDependencies": {
          "@types/react": "*"
        }
      },
      "react-native-safe-area-context@5.4.0": {
        "peerDependencies": {
          "@types/react": "*"
        }
      }
    }
  }
}
