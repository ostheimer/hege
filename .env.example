APP_DOMAIN=hege.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
DATABASE_URL=postgresql://hege:hege@127.0.0.1:5432/hege
DATABASE_URL_UNPOOLED=postgresql://hege:hege@127.0.0.1:5432/hege
DEV_USER_ID=user-huber
DEV_MEMBERSHIP_ID=member-jaeger
DEV_REVIER_ID=revier-attersee
HEGE_USE_DEMO_STORE=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hege
POSTGRES_USER=hege
POSTGRES_PASSWORD=hege
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=hege-assets
S3_PUBLIC_BASE_URL=http://localhost:9000/hege-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
HEGE_GEO_PROVIDER=live
GOOGLE_MAPS_REGION=AT
GOOGLE_MAPS_LANGUAGE=de
# GOOGLE_MAPS_SERVER_API_KEY=
# Browser-Key für die Backoffice-Karte (Next.js liest NUR NEXT_PUBLIC_*).
# In Vercel Preview/Production setzen, sonst rendert die Karte einen Fallback.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Rückwärtskompatibler Alias für bestehende Deployments.
# NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY=
# Optional: separate Map-ID für das Backoffice-Map-Styling.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Browser-Key für die Mobile-App auf Android (react-native-maps Provider
# Google). Expo liest NUR EXPO_PUBLIC_*. iOS nutzt Apple Maps ohne Key.
EXPO_PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY=
# GIP_ROAD_KILOMETER_ENDPOINT=
GIP_ROAD_KILOMETER_INDEX_PATH=
GIP_ROAD_KILOMETER_MAX_DISTANCE_METERS=150
API_PORT=4000
